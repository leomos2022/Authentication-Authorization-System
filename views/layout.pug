doctype html
html(lang='en')
  head
    title NodeAuth — Secure Authentication
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')

    //- Bootstrap 5
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    //- Bootstrap Icons
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    //- Custom styles
    link(rel='stylesheet', href='/css/style.css')

  body.bg-light

    //- Navbar
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm.fixed-top
      .container
        a.navbar-brand.fw-bold(href='/')
          i.bi.bi-shield-lock-fill.me-2
          | NodeAuth
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav', aria-controls='navbarNav', aria-expanded='false', aria-label='Toggle navigation')
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            li.nav-item
              a.nav-link(href='/', class=(title === 'Home' ? 'active' : ''))
                i.bi.bi-house-fill.me-1
                | Dashboard
          ul.navbar-nav.ms-auto
            if user
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown')
                  span.avatar-initials.me-2= user.name ? user.name.charAt(0).toUpperCase() : user.username.charAt(0).toUpperCase()
                  | #{user.name || user.username}
                ul.dropdown-menu.dropdown-menu-end
                  li
                    a.dropdown-item(href='/users/logout')
                      i.bi.bi-box-arrow-right.me-2
                      | Logout
            else
              li.nav-item
                a.nav-link(href='/users/register', class=(title === 'Register' ? 'active' : ''))
                  i.bi.bi-person-plus.me-1
                  | Register
              li.nav-item
                a.nav-link(href='/users/login', class=(title === 'Login' ? 'active' : ''))
                  i.bi.bi-box-arrow-in-right.me-1
                  | Login

    //- Bootstrap 5 Toast container for flash messages
    .toast-container.position-fixed.top-0.end-0.p-3(style='z-index: 1100; margin-top: 70px;')
      if flashSuccess && flashSuccess.length
        each msg in flashSuccess
          .toast.align-items-center.text-bg-success.border-0(role='alert', aria-live='assertive')
            .d-flex
              .toast-body
                i.bi.bi-check-circle-fill.me-2
                | #{msg}
              button.btn-close.btn-close-white.me-2.m-auto(type='button', data-bs-dismiss='toast')
      if flashError && flashError.length
        each msg in flashError
          .toast.align-items-center.text-bg-danger.border-0(role='alert', aria-live='assertive')
            .d-flex
              .toast-body
                i.bi.bi-exclamation-triangle-fill.me-2
                | #{msg}
              button.btn-close.btn-close-white.me-2.m-auto(type='button', data-bs-dismiss='toast')
      if flashInfo && flashInfo.length
        each msg in flashInfo
          .toast.align-items-center.text-bg-info.border-0(role='alert', aria-live='assertive')
            .d-flex
              .toast-body
                i.bi.bi-info-circle-fill.me-2
                | #{msg}
              button.btn-close.btn-close-white.me-2.m-auto(type='button', data-bs-dismiss='toast')

    //- Main content
    main.container.py-5.mt-5
      block content

    //- Footer
    footer.bg-dark.text-white-50.py-3.mt-5
      .container.text-center
        small
          i.bi.bi-shield-check.me-1
          | &copy; #{new Date().getFullYear()} NodeAuth — Built with Node.js, Express &amp; MongoDB

    //- Bootstrap 5 JS
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    //- Auto-show all toasts on page load
    script.
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.toast').forEach(function (el) {
          new bootstrap.Toast(el, { delay: 4000 }).show();
        });
      });
    block scripts
