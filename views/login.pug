extends layout

block content
  .row.justify-content-center
    .col-md-5.col-lg-4
      .card.shadow-sm.border-0.rounded-4
        .card-body.p-4.p-md-5
          .text-center.mb-4
            .auth-icon.mx-auto.mb-3
              i.bi.bi-shield-lock-fill
            h2.fw-bold Welcome back
            p.text-muted Sign in to your account

          form(method='post', action='/users/login', novalidate)

            .form-floating.mb-3
              input#username.form-control.rounded-3(
                type='text',
                name='username',
                placeholder='Username',
                autocomplete='username',
                autofocus
              )
              label(for='username')
                i.bi.bi-at.me-1
                | Username

            .form-floating.mb-4
              input#password.form-control.rounded-3(
                type='password',
                name='password',
                placeholder='Password',
                autocomplete='current-password'
              )
              label(for='password')
                i.bi.bi-lock.me-1
                | Password

            .d-grid
              button.btn.btn-dark.btn-lg.rounded-3(type='submit')
                i.bi.bi-box-arrow-in-right.me-2
                | Sign In

          hr.my-4
          p.text-center.text-muted.mb-0
            | Don't have an account?&nbsp;
            a.fw-semibold(href='/users/register') Create one
